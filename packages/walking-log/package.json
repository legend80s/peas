{
  "name": "walking-log",
  "description": "A light-weight consola: A simple console.log only for printing messages in Node.js with colors, time, time diff and emojis. I use it in CLI app usually",
  "private": false,
  "version": "1.2.4",
  "type": "module",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "logger.type.ts"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "which tsc && tsc -v && tsc --noEmit",
    "generate:types": "rm -rf dist && tsc index.js --declaration --emitDeclarationOnly --outDir dist --ignoreConfig --allowJs",
    "commit": "bash ../../scripts/git-commit.sh",
    "prepack": "pnpm run generate:types",
    "preversion": "pnpm test && pnpm run typecheck && shipwright && pnpm run generate:types",
    "postpublish": "pnpm run push",
    "push": "pnpm run commit && git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/legend80s/peas/tree/main/packages/walking-log"
  },
  "homepage": "https://github.com/legend80s/peas/tree/main/packages/walking-log",
  "keywords": [
    "consola",
    "console",
    "log",
    "logger",
    "logging",
    "debug",
    "info",
    "warn",
    "error",
    "fatal",
    "node",
    "nodejs"
  ]
}
